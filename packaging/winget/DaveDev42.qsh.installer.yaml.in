# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.6.0.schema.json

PackageIdentifier: DaveDev42.qsh
PackageVersion: @VERSION@
# The release zip holds qsh.exe at its root next to a directory of man pages.
# winget has no man path convention, so only the portable qsh.exe is linked.
InstallerType: zip
NestedInstallerType: portable
NestedInstallerFiles:
- RelativeFilePath: qsh.exe
  PortableCommandAlias: qsh
# Windows 10 1809 is the VT floor of the console layer.
MinimumOSVersion: 10.0.17763.0
Installers:
- Architecture: x64
  InstallerUrl: https://github.com/DaveDev42/qsh/releases/download/@TAG@/qsh-@TAG@-x86_64-pc-windows-msvc.zip
  InstallerSha256: @SHA256_X64_UPPER@
- Architecture: arm64
  InstallerUrl: https://github.com/DaveDev42/qsh/releases/download/@TAG@/qsh-@TAG@-aarch64-pc-windows-msvc.zip
  InstallerSha256: @SHA256_ARM64_UPPER@
ManifestType: installer
ManifestVersion: 1.6.0
