{
    "version": "@VERSION@",
    "description": "QUIC-based direct-connect remote shell whose sessions survive IP changes, sleep and network switches",
    "homepage": "https://github.com/DaveDev42/qsh",
    "license": "MIT|Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/DaveDev42/qsh/releases/download/@TAG@/qsh-@TAG@-x86_64-pc-windows-msvc.zip",
            "hash": "@SHA256_X64@"
        },
        "arm64": {
            "url": "https://github.com/DaveDev42/qsh/releases/download/@TAG@/qsh-@TAG@-aarch64-pc-windows-msvc.zip",
            "hash": "@SHA256_ARM64@"
        }
    },
    "bin": "qsh.exe",
    "checkver": {
        "github": "https://github.com/DaveDev42/qsh"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/DaveDev42/qsh/releases/download/v$version/qsh-v$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/DaveDev42/qsh/releases/download/v$version/qsh-v$version-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "https://github.com/DaveDev42/qsh/releases/download/v$version/SHA256SUMS",
            "regex": "$sha256\\s+$basename"
        }
    }
}
