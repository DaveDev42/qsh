          "type": "object"
        },
        "name": "open_tunnel"
      },
      {
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "after_sequence": {
              "default": 0,
              "description": "Cumulative output byte offset already received (`--after`); the\nreply starts right after it.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "ctl_after": {
              "description": "Control-entry cursor (`--ctl-after`): the `next_ctl_after` of the\nprevious reply, `0` (the default) for a fresh read. Control events\n(`session.exit`/`writer_changed`/`closed`) carry the offset they were\nappended at and do **not** advance it, so `after_sequence` alone\ncannot express \"I already have the control event positioned at N\";\na poller that does not echo this back sees such an event again on\nevery pull (`docs/CLI.md` §6.4). Additive (`qsh.cli/v1`), so it is\nomitted entirely when unset.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "limit_bytes": {
              "description": "Maximum output payload bytes in one reply (`--limit-bytes`); `None`\n= server default.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "session_ref": {
              "description": "Opaque session handle.",
              "type": "string"
            },
            "wait_ms": {
              "description": "Long-poll wait for new output in milliseconds (`--wait`); `None` =\nreturn immediately.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
