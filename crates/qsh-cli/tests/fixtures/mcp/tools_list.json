            "signal": {
              "description": "First signal of the HUP → TERM → KILL escalation, canonical\n`SIGTERM` form (`--signal`, one of HUP|INT|QUIT|TERM|USR1|USR2|KILL);\n`None` = default (SIGHUP).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "session_ref"
          ],
          "type": "object"
        },
        "name": "close_session"
      },
      {
        "inputSchema": {
