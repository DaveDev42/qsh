                "$ref": "#/$defs/EnvVar"
              },
              "type": "array"
            },
            "host": {
              "description": "Host alias.",
              "type": "string"
            },
            "rows": {
              "description": "Initial terminal height; `None` = remote default.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "term": {
              "description": "`TERM` to export in the session; `None` = remote default.",
              "type": [
                "string",
                "null"
              ]
            },
            "user": {
              "description": "The `user` half of `qsh user@host` — a hint checked against the\nremote serve account's login name (`docs/CLI.md` §7); never an\nidentity (the principal always comes from the certificate).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "host"
          ],
          "type": "object"
        },
        "name": "open_session"
