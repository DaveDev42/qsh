            }
          },
          "required": [
            "tunnel_id"
          ],
          "type": "object"
        },
        "name": "close_tunnel"
      },
      {
        "inputSchema": {
          "$defs": {
            "EnvVar": {
              "description": "One `NAME=value` environment entry for [`ExecRunReq::env`].",
              "properties": {
                "name": {
                  "description": "Variable name.",
                  "type": "string"
                },
                "value": {
                  "description": "Variable value.",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value"
              ],
              "type": "object"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "argv": {
              "description": "Program and arguments, passed to the remote verbatim (no shell\nre-interpretation).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "env": {
              "description": "Extra environment variables layered over the remote environment.",
              "items": {
                "$ref": "#/$defs/EnvVar"
              },
              "type": "array"
            },
            "host": {
              "description": "Host name. Until the hosts.toml directory lands (M7) this is resolved\nthrough the trust store's pinned peers (name → address).",
              "type": "string"
            },
            "timeout_ms": {
              "description": "Whole-operation timeout in milliseconds (`docs/CLI.md` §9). `None`\nmeans no timeout.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
